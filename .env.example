# Database (async driver URL — asyncpg is used for API, psycopg2 derived automatically for worker)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bravey

# Encryption (32-byte hex-encoded AES-256 key)
# Generate with: python -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=

# Linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=          # PEM file contents (replace newlines with \n)
GITHUB_WEBHOOK_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# AWS SQS
SQS_QUEUE_URL=
AWS_REGION=us-east-1
